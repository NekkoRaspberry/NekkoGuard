# Copy to .env (git-ignored) to override defaults. All values are optional.

# --- docker compose ---------------------------------------------------------
# Docker network created by the backend compose project (name: nekkoguard).
BACKEND_NETWORK=nekkoguard_default
# Where nginx / Vite forward backend requests (Docker service name + port).
BACKEND_URL=http://django:8000
# Host ports.
FRONTEND_PORT=8080
FRONTEND_DEV_PORT=5173
# Extra host names the Vite dev server accepts (comma-separated), e.g. nekkoraspberry.local
VITE_ALLOWED_HOSTS=

# --- build-time (baked into the bundle; leave empty for same-origin) --------
# VITE_API_BASE_URL=
# VITE_WS_URL=
# VITE_BACKEND_PUBLIC_URL=
