# NekkoGuard frontend — nginx site config.
#
# Rendered at container start by the nginx image's envsubst step. Only variables that
# exist in the environment are substituted (${BACKEND_URL}); nginx's own $variables stay.
#
# Same-origin design: the browser only ever talks to this server. Backend paths are
# proxied to Django, so no CORS is needed and allauth pages work under the same host.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    server_tokens off;
    client_max_body_size 10m;
    charset utf-8;

    # Resolve the backend through Docker's DNS at request time, so nginx starts (and the
    # SPA can show "server unreachable") even when the backend container is down.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend ${BACKEND_URL};

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # --- Backend (Django) --------------------------------------------------------
    location ~ ^/(api|_allauth|accounts|users|static)/ {
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    # WebSocket heartbeat (backend accepts any path; the SPA uses /ws/).
    location /ws/ {
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # --- Single-page app ---------------------------------------------------------
    # Hashed build assets: cache forever.
    location /assets/ {
        include /etc/nginx/conf.d/spa-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # index.html must always be revalidated so new deployments are picked up.
    location = /index.html {
        include /etc/nginx/conf.d/spa-headers.inc;
        add_header Cache-Control "no-cache" always;
    }

    location / {
        include /etc/nginx/conf.d/spa-headers.inc;
        try_files $uri /index.html;
    }
}
